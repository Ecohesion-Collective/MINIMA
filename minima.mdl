Annual wage=
	 if then else(Time=0, Initial wage,
	    Annual wage delay * (1 + Wage growth + Wage growth policy)
	  )
	~	Current euro/Person/Year
	~	Base wage*((1+Wage sensitivity*(Threshold unemployment-Unemployment rate delay)+Wage \
		sensitivity
		*Labour productivity growth after damages)
		+Wage growth policy*Time
		)
	|

Annual wage delay= DELAY FIXED (
	 Annual wage , 1 , Initial wage)
	~	Current euro/Person/Year
	~		|

Annual wage index=
	Annual wage/Initial wage
	~	1
	~		|

