	Deforestation intensity of output*Output
	~	Ton/Year
	~		|

Loans interest payment=
	Interest rate*Stock of Loans
	~	Current euro/Year
	~		|

Loans interest payment delay=
	DELAY FIXED(Loans interest payment, 1 , 10 )
	~	Current euro/Year
	~		|

Loans payment=
	Stock of Loans*Loans repayment rate
	~	Current euro/Year
	~	Loans repayment share*Stock of Loans
	|

Loans payment delay= DELAY FIXED (
	Loans payment, 1 , 10)
	~	Current euro/Year
	~		|

Loans repayment rate=
	0.01
	~	1/Year
	~		|

Lost materials=
	(Direct disposal+Depreciation rate*Socioeconomic Stock)
	*Fraction of material disposal that is lost
	~	Ton/Year
	~		|

M constraint tightness=
	Output/M potential output
	~	Dmnl
	~		|

M constraint tightness delay= DELAY FIXED (
	M constraint tightness, 1, initial constraints tightness)
	~	Dmnl
	~		|

M desired sink constraint closure=
	Act policy reaction waste*Relative to max waste^Reaction exponent
	~	1
	~		|

M desired source constraint closure=
	M constraint tightness delay^Reaction exponent
	~	Dmnl
	~		|

M potential output=
	(Maximum materials extraction+min(Maximum materials recycling,Maximum recyclable materials stock\
		))/Material intensity output
	~	Euro/Year
	~		|

Mark up=
	max(0,Mark up adjustment speed*Base mark up+(1-Mark up adjustment speed)*Mark up delay\
		+Mark up rationing sensitivity
	*(1-Rationing rule))
	~	Dmnl
	~		|

Mark up adjustment speed=
	0.05
	~	Dmnl
	~		|

Mark up delay=
	DELAY FIXED(Mark up, 1 ,Initial mark up )
	~	Dmnl
	~		|

Mark up rationing sensitivity=
	1
	~	Dmnl
	~		|

Mark up reduction parameter=
	0.5
	~	Dmnl
	~		|

Mark up reduction policy=
	Activate Wage Increase*Mark up reduction parameter
	~	Dmnl
	~		|

Material efficiency=
	Activate Material Efficiency*(Material efficiency rate*(Time-Time policy))
	~	Dmnl
	~		|

Material efficiency rate=
	0.0055
	~	1/Year
	~		|

Material intensity output=
	Base material intensity*(1-Material efficiency)
	~	Ton/Euro
	~		|

Materials= INTEG (
	-Materials extraction,
		Initial Material stock)
	~	Ton
	~		|

Materials demand=
	Material intensity output*Output
	~	Ton/Year
	~		|

Materials extraction=
	min(Materials demand - Recycled materials, Maximum materials extraction)
	~	Ton/Year
	~		|

max scale increase=
	0.125
	~	Dmnl/Year
	~		|

Max temperature goal=
	2
	~	Celsius
	~		|

Max waste goal=
	40000
	~	Ton
	~		|

Maximum forest regeneration rate=
	0.05
	~	1/Year
	~		|

Maximum fossil generation=
	Fossils*Capacity factor fossil*Fossil energy content
	~	TJ/Year
	~		|

Maximum materials extraction=
	Capacity factor materials*Materials
	~	Ton/Year
	~		|

Maximum materials recycling=
	Capital MR*Capital productivity recycling
	~	Ton/Year
	~		|

Maximum recyclable materials stock=
	Maximum recycling capacity*Waste materials
	~	Ton/Year
	~		|

Maximum recycling capacity=
	0.2
	~	Dmnl/Year
	~		|

Maximum renewable energy generation=
	Capital ER*Capital productivity Renewable Energy
	~	TJ/Year
	~		|

Maximum useful MR capital=
	Maximum recyclable materials stock/Capital productivity recycling
	~	Euro
	~		|

Mean temperature=
	Preindustrial temperature+Temperature sensitivity to CO2 increase*((CO2/Initial CO2)
-1)
	~	Celsius
	~		|

Mean temperature increase=
	Mean temperature-Preindustrial temperature
	~	Celsius
	~		|

Mortality damages=
	if then else(Act Mortality Damages=0,0,if then else(Act Mortality Damages=1,Pessimistic mortality damage function
, if then else(Act Mortality Damages=2,Optimistic mortality damage function, Mortality Extreme Event Shock
	)))*(if then else(Act Mortality Damages=0,1,Demographic impacts reduction due to adaptation
))
	~	Dmnl
	~		|

Mortality Extreme Event Shock=
	min(1,if then else(Mean temperature increase >3 :AND: Mean temperature increase < 3.2
,
	                     Mortality Extreme Events, 0))
	~	Dmnl
	~	This extreme climate shock appears when Temperature Increase reaches 3ºC, \
		reflecting the idea of dramatic and abrupt changes when temperature \
		increases are beyond 2.5ºC, according to Dangerous Climate Change \
		literature.
	|

Mortality Extreme Events= INTEG (
	Accumulated Mortality Damages,
		0)
	~	Dmnl
	~		|

Mortality rate=
	Base mortality rate*(1+Mortality damages)
	~	1/Year
	~		|

Natality rate=
	0.017
	~	1/Year
	~	0.017
	|

Net change in Loans=
	New loans-Loans payment
	~	Current euro/Year
	~		|

net worth bank=
	Stock of Loans-Stock of Deposits
	~	Current euro
	~		|

net worth firms=
	Price delay*(Capital ER+Capital MR+Capital O)-Stock of Loans
	~	Current euro
	~		|

net worth government=
	-Stock of bonds
	~	Current euro
	~		|

net worth hh=
	Stock of Deposits+Stock of bonds
	~	Current euro
	~		|

net worth sum=
	net worth bank+net worth firms+net worth government+net worth hh
	-(Capital ER+Capital MR+Capital O)*Price delay
	~	Current euro
	~		|

New bonds=
	Government deficit
	~	Current euro/Year
	~		|

New loans=
	Nominal investment
	~	Current euro/Year
	~		|

Nominal consumption=
	Price*Consumption
	~	Current euro/Year
	~		|

Nominal government spending=
	Price*Total government spending
	~	Current euro/Year
	~		|

Nominal investment=
	Price*Investment
	~	Current euro/Year
	~		|

Nominal output=
	Output*Price
	~	Current euro/Year
	~		|

Normal capacity=
	0.8
	~	Dmnl
	~		|

Normal Output=
	K Potential Output*Normal capacity
	~	Euro/Year
	~		|

O2 used=
	Fossil emissions-Fossil extraction
	~	Ton/Year
	~		|

Optimistic capital damage function=
	(1-(1/(1+(Mean temperature increase/TPO1)^2+(Mean temperature increase/TPO2)^6.754)
	))*0.3
	~	Dmnl
	~	We use the Weitzman (2012) function to represent an optimistic level of \
		damage ( https://doi.org/10.1111/j.1467-9779.2011.01539.x). Since the \
		Weitzman damage function represents GDP damage, we multiply this by 0.3% \
		to represent the corresponding part affecting capital. The rest of the \
		damage is applied to labour. We use this approach, as done in Bovari et \
		al. (2018) (https://doi.org/10.1016/j.ecolecon.2018.01.034) given that \
		there does not exist global damage function measuring capital losses. We \
		also calibrate damages to be higher in labour than in capital, as \
		literature supports (see, for instance, Burke et al., 2015).
	|

Optimistic labour damage function=
	(1-(1/(1+(Mean temperature increase/TPO1)^2+(Mean temperature increase/TPO2)^6.754)
	))*0.7
	~	Dmnl
	~	We use the Weitzman (2012) function to represent an optimistic level of \
		damage ( https://doi.org/10.1111/j.1467-9779.2011.01539.x). Since the \
		Weitzman damage function represents GDP damage, we multiply this by 0.7% \
		to represent the corresponding part affecting labour. The rest of the \
		damage is applied to capital. We use this approach, as done in Bovari et \
		al. (2018) (https://doi.org/10.1016/j.ecolecon.2018.01.034) given that \
		there does not exist global damage function measuring capital losses. We \
		also calibrate damages to be higher in labour than in capital, as \
		literature supports (see, for instance, Burke et al., 2015).
	|

Optimistic mortality damage function=
	(TPMO1*Mean temperature increase-TPMO2*Mean temperature increase^2)/100
	~	Dmnl
	~	This function is calibrated to follow the Bressler et al. (2021) global \
		damage function capturing heat and cold stress damages in mortality, for \
		the 2.5th percentile range. See Figure 3 in \
		https://doi.org/10.1038/s41598-021-99156-5 for details.
	|

Output=
	Final demand
	~	Euro/Year
	~		|

Output delay= DELAY FIXED (
	Output, 1 ,Initial Output)
	~	Euro/Year
	~		|

Output per capita=
	Output/Population
	~	Euro/(Year*Person)
	~		|

Output to capital ratio=
	0.625
	~	1/Year
	~	Output to capital ratio (capital productivity)
	|

Participation sensitivity to unemployment=
	0.2
	~	Dmnl
	~		|

Pessimistic capital damage function=
	(1-(1/(1+(Mean temperature increase/TPP1)^2+(Mean temperature increase/TPP2)^7.02)))
*0.3
	~	Dmnl
	~	We use the Dietz and Stern (2015) function to represent an pessimistic \
		level of damage (https://doi.org/10.1111/ecoj.12188). Since the Dietz and \
		Stern damage function represents GDP damage, we multiply this by 0.3% to \
		represent the corresponding part affecting capital. The rest of the damage \
		is applied to labour. We use this approach, as done in Bovari et al. \
		(2018) (https://doi.org/10.1016/j.ecolecon.2018.01.034) given that there \
		does not exist global damage function measuring capital losses. We also \
		calibrate damages to be higher in labour than in capital, as literature \
		supports (see, for instance, Burke et al., 2015).
	|

Pessimistic labour damage function=
	(1-(1/(1+(Mean temperature increase/TPP1)^2+(Mean temperature increase/TPP2)^7.02)))
*0.7
	~	Dmnl
	~	We use the Dietz and Stern (2015) function to represent an optimistic \
		level of damage (https://doi.org/10.1111/ecoj.12188). Since the Dietz and \
		Stern damage function represents GDP damage, we multiply this by 0.7% to \
		represent the corresponding part affecting labour. The rest of the damage \
		is applied to capital. We use this approach, as done in Bovari et al. \
		(2018) (https://doi.org/10.1016/j.ecolecon.2018.01.034) given that there \
		does not exist global damage function measuring labour losses. We also \
		calibrate damages to be higher in labour than in capital, as literature \
		supports (see, for instance, Burke et al., 2015).
	|

Pessimistic mortality damage function=
	(TPMP1*Mean temperature increase+TPMP2*Mean temperature increase^2)/100
	~	Dmnl
	~	This function is calibrated to follow the Bressler et al. (2021) global \
		damage function capturing heat and cold stress damages in mortality, for \
		the 97.5th percentile range. See Figure 3 in \
		https://doi.org/10.1038/s41598-021-99156-5 for details.
	|

Planned Inv ER=
	max(0,required net investment ER*Renewables net investment adjustment pace+Depreciation ER\
		)
	~	Euro/Year
	~		|

Planned Inv MR=
	max(0,required net investment MR*Recycling net investment adjustment pace+Depreciation MR\
		)
	~	Euro/Year
	~		|

Population= INTEG (
	Births-Deaths,
		Initial Population)
	~	Person
	~		|

Post interest profits=
	Profits-Loans interest payment
	~	Current euro/Year
	~		|

Potential output=
	min(L Potential Output,min(min(K Potential Output,E Potential Output),M potential output
))
	~	Euro/Year
	~		|

Potential output delay= DELAY FIXED (
	Potential output , 1 , Initial Potential output)
	~	Euro/Year
	~		|

Preindustrial temperature=
	25
	~	Celsius
	~		|

Price=
	(Unit labour cost+Unit debt service cost+Unit capital cost)*(1+Mark up)
	~	Current euro/Euro
	~		|

Price delay=
	DELAY FIXED(Price, 1 , 1 )
	~	Current euro/Euro
	~		|

Profits=
	Nominal output-Labour income
	~	Current euro/Year
	~		|

Public debt to output ratio=
	Stock of bonds/Nominal output
	~	Year
	~	Public debt to GDP ratio
	|

Rationing rule=
	min(1,Potential output/desired final demand)
	~	Dmnl
	~		|

Reaction exponent=
	2
	~	Dmnl
	~		|

Real capital income=
	Capital income/Price
	~	Euro/Year
	~		|

Real capital income index=
	Real capital income/Initial real capital income
	~	Dmnl
	~		|

Real consumption per capita=
	(Consumption/Price)/Population
	~	Euro*Euro/(Year*Current euro*Person)
	~		|

Real Government Deficit=
	Government deficit/Price
	~	Euro/Year
	~		|

Real labour income=
	Labour income/Price
	~	Euro/Year
	~		|

Real labour income index=
	Real labour income/Initial real labour income
	~	Dmnl
	~		|

Real wage=
	Annual wage/Price
	~	Euro/(Year*Person)
	~		|

Real wealth delay=
	Households Wealth/Price delay
	~	Euro
	~		|

Real wealth index=
	Real wealth delay/Initial real wealth
	~	Dmnl
	~		|

Recycled materials=
	min(min(Maximum materials recycling,Maximum recyclable materials stock),Materials demand\
		)
	~	Ton/Year
	~		|

Recycled materials share=
	Recycled materials/(Recycled materials+Materials extraction)
	~	Dmnl
	~		|

Recycled materials share delay= DELAY FIXED (
	Recycled materials share , 1 , Initial recycled materials share)
	~	Dmnl
	~		|

Recycling improvement rate=
	0.005
	~	1/Year
	~		|

Recycling Improvements=
	Activate Recycling*(Recycling improvement rate*(Time-Time policy))
	~	Dmnl
	~		|

Recycling net investment adjustment pace=
	0.3
	~	Dmnl/Year
	~		|

Redundant equation LD=
	Stock of Deposits-Stock of Loans
	~	Current euro
	~		|

Reforestation=
	Reforestation rate*Activate Reforestation
	~	Dmnl
	~		|

Reforestation rate=
	0.01
	~	Dmnl
	~		|

Relative to max temperature increase=
	min(Mean temperature increase/Max temperature goal,
	1)
	~	Dmnl
	~		|

Relative to max waste=
	min((Waste materials+Unrecoverable waste)/Max waste goal
	,1)
	~	Dmnl
	~		|

Renewable Energy=
	min(Maximum renewable energy generation,Energy demand)
	~	TJ/Year
	~		|

Renewable Energy Share=
	Renewable Energy/(Renewable Energy+Fossil energy)
	~	Dmnl
	~		|

Renewables net investment adjustment pace=
	0.3
	~	Dmnl/Year
	~		|

required ER capital=
	if then else(E constraint tightness delay<1,Output delay*(1+Economic growth delay)^2\
		,desired final demand delay)
	*Energy intensity output*desired renewable share/Capital productivity Renewable Energy
	~	Euro
	~		|

required MR capital=
	min(if then else(M constraint tightness delay<1,Output delay*(1+Economic growth delay\
		)^2,desired final demand delay)
	*Material intensity output*desired recycling share/Capital productivity recycling,
	
	Maximum useful MR capital)
	~	Euro
	~		|

required net investment ER=
	required ER capital-Capital ER
	~	Euro
	~		|

required net investment MR=
	required MR capital-Capital MR
	~	Euro
	~		|

RES expansion rate=
	200
	~	Euro/Year
	~		|

Savings=
	Disposable capital income+Disposable labour income-Nominal consumption
	~	Current euro/Year
	~		|

Socioeconomic Stock= INTEG (
	Materials extraction+Recycled materials-Disposal-Lost materials,
		Initial socioeconomic stock)
	~	Ton
	~		|

Stock of bonds= INTEG (
	New bonds,
		Initial bonds)
	~	Current euro
	~		|

Stock of Deposits= INTEG (
	Change in deposits,
		Initial Deposit)
	~	Current euro
	~		|

Stock of Loans= INTEG (
	New loans-Loans payment,
		Initial loans)
	~	Current euro
	~		|

Temperature sensitivity to CO2 increase=
	0.8
	~	Celsius
	~	2
	|

Time damage accumulation=
	1
	~	Year
	~		|

Time policy=
	10
	~	Year
	~		|

total Capital stock=
	Capital ER+Capital MR+Capital O
	~	Euro
	~		|

total capital stock physical=
	total Capital stock*Material intensity output
	~	Ton
	~		|

Total debt to output ratio=
	(Stock of bonds+Stock of Loans)/Nominal output
	~	Year
	~	Total (public + private) debt to GDP ratio
	|

Total emissions=
	Fossil emissions+Land use emissions
	~	Ton/Year
	~		|

Total government spending=
	Government spending+Adaptation cost
	~	Euro/Year
	~		|

TPMO1=
	0.9687
	~	1/Celsius
	~		|

TPMO2=
	0.001613
	~	1/Celsius/Celsius
	~		|

TPMP1=
	2.202
	~	1/Celsius
	~		|

TPMP2=
	0.315
	~	1/Celsius/Celsius
	~		|

TPO1=
	20.46
	~	Celsius
	~		|

TPO2=
	6.08
	~	Celsius
	~		|

TPP1=
	12.2
	~	Celsius
	~		|

TPP2=
	4
	~	Celsius
	~		|

uc Recycling=
	Recycled materials/Maximum materials recycling
	~	Dmnl
	~		|

uc RES=
	Renewable Energy/Maximum renewable energy generation
	~	Dmnl
	~		|

Unemployment=
	Labour force-Employment
	~	Person
	~		|

Unemployment rate=
	Unemployment/Labour force
	~	Dmnl
	~		|

Unemployment rate delay= DELAY FIXED (
	Unemployment rate , 1 , Initial unemployment rate)
	~	Dmnl
	~		|

Unit capital cost=
	(Depreciation ER delay+Depreciation MR delay+Depreciation O delay)*Price delay/Normal Output
	~	Current euro/Euro
	~		|

Unit debt service cost=
	(Loans interest payment delay)/Normal Output
	~	Current euro/Euro
	~	(Loans interest payment delay+Loans payment delay)/Output delay
	|

Unit labour cost=
	Labour income delay/Output delay
	~	Current euro/Euro
	~		|

Unrecoverable waste= INTEG (
	Lost materials,
		Initial unrecoverable waste)
	~	Ton
	~		|

Wage growth=
	Wage sensitivity inflation*Inflation delay
	+Wage sensitivity unemployment*(1-Unemployment rate delay)
	+Wage sensitivity productivity*Labour productivity growth delay
	~	Dmnl
	~		|

Wage growth policy=
	Wage growth policy rate*Activate Wage Increase
	~	Dmnl
	~		|

Wage growth policy rate=
	0.01
	~	Dmnl
	~		|

Wage sensitivity inflation=
	0.5
	~	Dmnl
	~	0.5
	|

Wage sensitivity productivity=
	1
	~	Dmnl
	~	1
	|

Wage sensitivity unemployment=
	0.01
	~	Dmnl
	~	0.01
	|

Waste materials= INTEG (
	Disposal-Recycled materials,
		Initial waste materials)
	~	Ton
	~		|

Working time index=
	1 - Activate WTR *
		    ( (1 - Act combine Degrowth WTR) * WTR independent
		      + Act combine Degrowth WTR* WTR degrowth )
	~	Dmnl
	~	1-(0.12*(Activate_WTR*ZIDZ((Time-Time policy),Time)))
		Working time reduction: switch between independent and degrowth-linked
	|

WTR degrowth=WTR max * ((1 - Degrowth)*WTR degrowth coefficient)
	~	Dmnl
	~	Working time reduction proportional to degrowth intensity
	|

WTR degrowth coefficient=2.5
	~	Dmnl
	~		|

WTR independent=
	min( WTR max ,
		     WTR rate * max(0, Time - Time policy) )
	~	Dmnl
	~	Working time reduction ramp independent of degrowth
	|

WTR max=
	0.5
	~	Dmnl
	~	Maximum working time reduction
	|

WTR rate=
	0.01
	~	1/Year
	~	Speed of working time reduction after policy
	|

