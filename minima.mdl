	~	1/Year
	~		|

Desired adaptation cost=
	if then else(Time<Time policy,0,
	Act Adapt Capital*Base adaptation cost*(1+Adaptation Capital Policy)+
	Act Adapt Mortality*Base adaptation cost*(1+Adaptation Mortality Policy)+
	Act Adapt Labour*Base adaptation cost*(1+Adaptation Labour Policy)
	)
	~	Euro/Year
	~	if then else(Time<Time policy,0,
		(Act Adapt Capital+Act Adapt Demography+Act Adapt Labour)*Base adaptation cost*(1+max
		(max(Adaptation Capital Policy,Adaptation Demography Policy
		),Adaptation Labour Policy
		)))
		
		if then else(Time<Time policy,0,
		Act Adapt*Base adaptation cost*(1+max(max(Adaptation Capital Policy,Adaptation \
		Demography Policy
		),Adaptation Labour Policy
		)))
	|

desired consumption=
	Consumption propensity of capital income*(Disposable capital income delay/Price delay\
		)
	+Consumption propensity of labour income*(Disposable labour income delay/Price delay\
		)
	+Consumption propensity of wealth*(Households Wealth/Price delay)
	~	Euro/Year
	~		|

desired final demand=
	desired consumption+desired government spending+Desired investment+Desired adaptation cost
	~	Euro/Year
	~		|

desired final demand delay=
	DELAY FIXED(desired final demand, 1, Initial Final demand )
	~	Euro/Year
	~		|

desired government spending=
	if then else(Time=0,Initial government spending,
	Government spending delay*(1+Government spending growth))
	~	Euro/Year
	~		|

Desired investment=
	Desired investment ER+Desired investment O+Desired investment MR
	~	Euro/Year
	~		|

Desired investment ER=
	min(Inv ER maximum,Planned Inv ER+Inv ER Policy)
	~	Euro/Year
	~		|

Desired investment MR=
	(min(Inv MR maximum,Planned Inv MR))
	~	Euro/Year
	~		|

Desired investment O=
	(Inv O delay*(1+Economic growth delay)
	*(1+Investment sensitivity to utilization gap*(Capacity utilization-Normal capacity)
	))
	~	Euro/Year
	~		|

desired recycling share=
	max(max(M desired source constraint closure,M desired sink constraint closure)
	,desired recycling share delayed)
	~	Dmnl
	~		|

desired recycling share delayed= DELAY FIXED (
	desired recycling share, 1, initial desired recycling share)
	~	1
	~		|

desired renewable share=
	max(max(E desired source constraint closure,E desired sink constraint closure)
	,desired renewable share delayed)
	~	Dmnl
	~		|

desired renewable share delayed=
	DELAY FIXED(desired renewable share, 1, Initial desired renewable share)
	~	Dmnl
	~		|

Direct disposal=
	(Materials extraction+Recycled materials)*Direct disposal share
	~	Ton/Year
	~		|

Direct disposal share=
	(Consumption+Total government spending)/Final demand
	~	Dmnl
	~		|

